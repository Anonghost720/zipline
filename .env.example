# PostgreSQL Database Configuration
# Generate with: openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
POSTGRESQL_PASSWORD=your_secure_password_here
POSTGRESQL_USER=zipline
POSTGRESQL_DB=zipline

# Zipline Core Configuration
# Generate with: openssl rand -base64 42 | tr -dc A-Za-z0-9 | cut -c -32
CORE_SECRET=your_core_secret_here

# Optional: Server Configuration
# CORE_PORT=3000
# CORE_HOSTNAME=0.0.0.0

# Optional: Trust Proxy (set to true if behind reverse proxy)
# CORE_TRUST_PROXY=true

# Optional: Local Storage Directory
# DATASOURCE_LOCAL_DIRECTORY=./uploads

# Optional: S3 Storage Configuration (alternative to local storage)
# DATASOURCE_TYPE=s3
# DATASOURCE_S3_ACCESS_KEY_ID=your_access_key
# DATASOURCE_S3_SECRET_ACCESS_KEY=your_secret_key
# DATASOURCE_S3_BUCKET=your_bucket_name
# DATASOURCE_S3_REGION=us-east-1
# DATASOURCE_S3_ENDPOINT=https://s3.amazonaws.com (optional, for S3-compatible services)

# Optional: OAuth Configuration
# OAUTH_GITHUB_CLIENT_ID=your_client_id
# OAUTH_GITHUB_CLIENT_SECRET=your_client_secret
# OAUTH_DISCORD_CLIENT_ID=your_client_id
# OAUTH_DISCORD_CLIENT_SECRET=your_client_secret
# OAUTH_GOOGLE_CLIENT_ID=your_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: Email Configuration (for notifications)
# CORE_MAILER_SMTP_HOST=smtp.gmail.com
# CORE_MAILER_SMTP_PORT=587
# CORE_MAILER_SMTP_SECURE=false
# CORE_MAILER_SMTP_USER=your_email@gmail.com
# CORE_MAILER_SMTP_PASSWORD=your_app_password
# CORE_MAILER_FROM=noreply@yourdomain.com
